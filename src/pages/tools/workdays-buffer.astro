---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/layout/AdSlot.astro';
import WorkdaysBuffer from '../../components/tools/WorkdaysBuffer.astro';
import { getCollection } from 'astro:content';

const guides = await getCollection('guides');
const related = ['workdays-buffer', 'hourly-rate-rough']
  .map((slug) => guides.find((g) => g.id === slug))
  .filter(Boolean);
---

<BaseLayout
  title="作業日数・バッファ計算機｜納期案"
  description="実働日数・バッファ％・休日を入れて、提案納期の日数と内訳説明の下書きを作成。ブラウザ完結。"
  canonicalPath="/tools/workdays-buffer/"
>
  <div class="wrap">
    <h1 class="page-title">作業日数／バッファ計算</h1>
    <p class="lede">実働に余裕と休みを足して、クライアントに伝えやすい納期日数の目安を出します。正式な工程表の代替ではありません。</p>
    <AdSlot placement="tool-above-ui" />
    <WorkdaysBuffer />
    <section class="prose">
      <h2>使い方・注意</h2>
      <ol>
        <li>実働日数（制作に充てる日数）を入力し、バッファ％（確認待ち・やり直しの余裕）と休日・待ち（先方確認・社内休みなど）を足します。</li>
        <li>「納期案を計算する」で合計日数と内訳が表示されます。「説明文の下書きをコピー」で見積もり文や進捗連絡に貼れる一文が得られます。</li>
        <li>
          実働日数やバッファの感覚は
          <a href="/guides/workdays-buffer/">作業日数とバッファの見積もり方</a>
          を先に読むと入力がぶれません。金額とのバランス確認には
          <a href="/guides/hourly-rate-rough/">時給換算の簡単な考え方</a>
          を併用してください。
        </li>
        <li>計算結果は「提案納期の目安」であり、納期の保証や工程表の代替ではありません。複数人・外部委託が絡む案件は、本ツールの数字に別途調整を足してください。</li>
        <li>入力はブラウザ内で処理し、サーバーには送信しません。公共端末では計算後に画面を閉じてください。</li>
        <li>説明文下書きは断定・保証表現を避ける方針です。コピー後に案件名・着手条件（素材支給日など）を必ず追記してください。</li>
        <li>
          遅延が見えたときは、出した日数案を
          <a href="/guides/delay-notice/">納期が遅れそうなときの連絡文</a>
          の型で先方に共有し、日程または範囲の代替案を提示します。
        </li>
      </ol>
    </section>
    <section class="related">
      <h2>使い方の詳細</h2>
      <ul>
        {related.map((g) => (
          <li>
            <a href={`/guides/${g!.id}/`}>{g!.data.title}</a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
