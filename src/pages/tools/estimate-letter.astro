---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/layout/AdSlot.astro';
import EstimateLetter from '../../components/tools/EstimateLetter.astro';
import { getCollection } from 'astro:content';

const guides = await getCollection('guides');
const related = ['estimate-letter', 'estimate-breakdown', 'revision-limits']
  .map((slug) => guides.find((g) => g.id === slug))
  .filter(Boolean);
---

<BaseLayout
  title="見積もり文ジェネレータ｜コピペ用"
  description="案件名・範囲・金額帯・納期・修正回数から、送れる見積もり文をブラウザで生成。入力はサーバーに送りません。"
  canonicalPath="/tools/estimate-letter/"
>
  <div class="wrap">
    <h1 class="page-title">見積もり文ジェネレータ</h1>
    <p class="lede">必要項目を埋めると、メールやチャットに貼れる見積もり文の下書きができます。契約書の代替ではありません。</p>
    <AdSlot placement="tool-above-ui" />
    <EstimateLetter />
    <section class="related">
      <h2>使い方の詳細</h2>
      <ul>
        {related.map((g) => (
          <li>
            <a href={`/guides/${g!.id}/`}>{g!.data.title}</a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
