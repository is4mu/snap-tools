---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/layout/AdSlot.astro';
import DeliveryChecklist from '../../components/tools/DeliveryChecklist.astro';
import { getCollection } from 'astro:content';

const guides = await getCollection('guides');
const related = ['delivery-checklist', 'invoice-delivery-mail']
  .map((slug) => guides.find((g) => g.id === slug))
  .filter(Boolean);
---

<BaseLayout
  title="納品チェックリスト｜漏れ防止"
  description="納品前の確認項目をチェック。任意追加と、印刷／コピー用テキスト出力に対応。進捗はブラウザ内に保存可。"
  canonicalPath="/tools/delivery-checklist/"
>
  <div class="wrap">
    <h1 class="page-title">納品チェックリスト</h1>
    <p class="lede">納品物と手続きの抜けを、送る前に一通り確認するためのリストです。</p>
    <AdSlot placement="tool-above-ui" />
    <DeliveryChecklist />
    <section class="prose">
      <h2>使い方・注意</h2>
      <ol>
        <li>納品前に初期項目へチェックを入れ、案件固有の確認（権限・納品先URL・版番号など）は「項目を追加」で足します。</li>
        <li>全項目にチェックが付いたら「リストをテキストでコピー」し、案件フォルダの <code>40_delivery/</code> に控えとして残すか、社内共有用に貼り付けます。</li>
        <li>印刷が必要なら「印刷用に表示」で紙のチェックリストとして使えます。公共のプリンタでは案件名や先方名の取り扱いに注意してください。</li>
        <li>チェック進捗はこのブラウザ内に保存されます。端末やブラウザを変えると引き継がれないため、重要案件はコピーしたテキストを案件フォルダに保存してください。</li>
        <li>
          リストの項目設計は
          <a href="/guides/delivery-checklist/">納品前チェックリストの作り方</a>
          を参照。納品メールと請求メールの書き分けは
          <a href="/guides/invoice-delivery-mail/">請求・納品メールの書き分け</a>
          を併せて確認します。
        </li>
        <li>本ツールは納品の品質保証や法的検収の代替ではありません。先方の検収手続きがある場合は、その要件を別途リストに追加してください。</li>
        <li>「チェックをクリア」は誤操作防止の確認付きです。納品完了後にリセットし、次案件用に空のリストから始めます。</li>
      </ol>
    </section>
    <section class="related">
      <h2>使い方の詳細</h2>
      <ul>
        {related.map((g) => (
          <li>
            <a href={`/guides/${g!.id}/`}>{g!.data.title}</a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
