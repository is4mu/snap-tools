---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/layout/AdSlot.astro';
import DeliveryChecklist from '../../components/tools/DeliveryChecklist.astro';
import { getCollection } from 'astro:content';

const guides = await getCollection('guides');
const related = ['delivery-checklist', 'invoice-delivery-mail']
  .map((slug) => guides.find((g) => g.id === slug))
  .filter(Boolean);
---

<BaseLayout
  title="納品チェックリスト｜漏れ防止"
  description="納品前の確認項目をチェック。任意追加と、印刷／コピー用テキスト出力に対応。進捗はブラウザ内に保存可。"
  canonicalPath="/tools/delivery-checklist/"
>
  <div class="wrap">
    <h1 class="page-title">納品チェックリスト</h1>
    <p class="lede">納品物と手続きの抜けを、送る前に一通り確認するためのリストです。</p>
    <AdSlot placement="tool-above-ui" />
    <DeliveryChecklist />
    <section class="related">
      <h2>使い方の詳細</h2>
      <ul>
        {related.map((g) => (
          <li>
            <a href={`/guides/${g!.id}/`}>{g!.data.title}</a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
